  {
   "bundle": "org/netbeans/modules/print/ui/Bundle.properties",
   "key": "TLT_Goto",
   "en": "<html><body>\\ &nbsp;<b>Navigation:</b>&nbsp;<br>\\ &nbsp;press <code>/</code> or <code>F</code> to show first page&nbsp;<br>\\ &nbsp;press <b><code>-</code></b> or <code>G</code> to show previous page&nbsp;<br>\\ &nbsp;press <b><code>+</code></b> or <code>K</code> to show next page&nbsp;<br>\\ &nbsp;press <code>*</code> or <code>L</code> to show last page&nbsp;\\ </body></html>",
   "zh": "<html><body>\\ &nbsp;<b>导航：</b>&nbsp;<br>\\ &nbsp;按 <code>/</code> 或 <code>F</code> 显示第一页&nbsp;<br>\\ &nbsp;按 <b><code>-</code></b> 或 <code>G</code> 显示上一页&nbsp;<br>\\ &nbsp;按 <b><code>+</code></b> 或 <code>K</code> 显示下一页&nbsp;<br>\\ &nbsp;按 <code>*</code> 或 <code>L</code> 显示最后一页&nbsp;\\ </body></html>"
  },
  {
   "bundle": "org/netbeans/modules/print/ui/Bundle.properties",
   "key": "TLT_Preview_Scale",
   "en": "<html><body>\\ &nbsp;<b>Adjusts the preview scale:</b>&nbsp;<br>\\ &nbsp;press &lt;plus&gt; to scale in&nbsp;<br>\\ &nbsp;press &lt;minus&gt; to scale out&nbsp;<br>\\ &nbsp;press <code>Ctrl</code>-&lt;plus&gt; to Zoom In&nbsp;<br>\\ &nbsp;press <code>Ctrl</code>-&lt;minus&gt; to Zoom Out&nbsp;<br>\\ &nbsp;press <code>/</code>&nbsp; to set 100%&nbsp;<br>\\ &nbsp;press <code>*</code> to customize view&nbsp;<br><hr>\\ &nbsp;mouse mouse wheel with <code>Ctrl</code> to Zoom In/Out&nbsp;<br>\\ &nbsp;mouse mouse wheel with right button to Zoom In/Out&nbsp;<br>\\ &nbsp;double click by left mouse button to Zoom In&nbsp;<br>\\ &nbsp;double click by right mouse button to Zoom Out&nbsp;<br>\\ </body></html>",
   "zh": "<html><body>\\ &nbsp;<b>调整预览缩放：</b>&nbsp;<br>\\ &nbsp;按 &lt;plus&gt; 放大&nbsp;<br>\\ &nbsp;按 &lt;minus&gt; 缩小&nbsp;<br>\\ &nbsp;按 <code>Ctrl</code>-&lt;plus&gt; 放大&nbsp;<br>\\ &nbsp;按 <code>Ctrl</code>-&lt;minus&gt; 缩小&nbsp;<br>\\ &nbsp;按 <code>/</code>&nbsp; 设为 100%&nbsp;<br>\\ &nbsp;按 <code>*</code> 自定义视图&nbsp;<br><hr>\\ &nbsp;按住 <code>Ctrl</code> 滚动鼠标滚轮可放大/缩小&nbsp;<br>\\ &nbsp;按住鼠标右键滚动滚轮可放大/缩小&nbsp;<br>\\ &nbsp;鼠标左键双击放大&nbsp;<br>\\ &nbsp;鼠标右键双击缩小&nbsp;<br>\\ </body></html>"
  },
